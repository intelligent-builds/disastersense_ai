<!-- app/templates/report.html -->
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>CitizenSOS — Report an Emergency</title>
  <style>
    :root{
      --bg:#f7fafc; --card:#fff; --muted:#6b7280;
      --accent:#0d6efd; --danger:#dc3545; --warn:#fd7e14; --success:#198754;
      --border:#e6edf3;
      font-family: "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    }
    body { background:var(--bg); margin:20px; color:#111; }
    .wrap { max-width:980px; margin:6px auto; }
    h1 { margin:8px 0 6px; font-size:28px; }
    p.small { margin:0 0 12px; color:var(--muted); }

    .card { background:var(--card); border-radius:10px; padding:16px; box-shadow:0 1px 6px rgba(20,20,20,0.04); border:1px solid var(--border); }

    textarea { width:100%; padding:12px; font-size:15px; box-sizing:border-box; border-radius:6px; border:1px solid #d6dbe0; resize:vertical; min-height:110px; }
    input[type="text"] { padding:8px; font-size:14px; width:180px; border-radius:6px; border:1px solid #d6dbe0; box-sizing:border-box; }

    .row { display:flex; gap:10px; align-items:center; margin:12px 0; flex-wrap:wrap; }
    button { padding:8px 12px; font-size:14px; cursor:pointer; border-radius:8px; border:1px solid #c7cbd0; background:#fff; }
    #sendBtn { background:var(--accent); color:#fff; border-color:var(--accent); }

    .out { white-space:pre-wrap; background:#fff; border:1px solid #eef2f7; padding:14px; margin-top:12px; border-radius:8px; }
    .map-link { display:inline-block; margin-top:8px; color:#0b5ed7; text-decoration:underline; }
    .ml-box { margin-top:12px; padding:12px; border-radius:8px; background:#fff8e6; border:1px solid #fff0d6; }
    .badge { display:inline-block; padding:6px 10px; margin:6px 6px 0 0; border-radius:999px; font-size:13px; color:#fff; }
    .badge-accent { background:var(--accent); }
    .badge-danger { background:var(--danger); }
    .badge-warn { background:var(--warn); }
    .badge-muted { background:#6c757d; }

    .small-muted { font-size:13px; color:var(--muted); margin-top:8px; }

    @media (max-width:760px){
      input[type="text"]{ width:140px; }
    }
  </style>
</head>
<body>
  <div class="wrap">
    <h1>CitizenSOS — Report an Emergency</h1>
    <p class="small">Describe what is happening. Add GPS if available or use <strong>Use my location</strong>.</p>

    <div class="card">
      <form id="repForm">
        <label for="message"><strong>Message</strong></label><br>
        <textarea id="message" name="message" rows="5" placeholder="e.g. Building collapsed near Padukkad, 3 people trapped" required>{{ prefill }}</textarea>

        <div class="row">
          <div>
            <label for="lat">Latitude</label><br>
            <input id="lat" name="lat" type="text" placeholder="optional" />
          </div>
          <div>
            <label for="lon">Longitude</label><br>
            <input id="lon" name="lon" type="text" placeholder="optional" />
          </div>

          <div style="margin-left:6px;">
            <button id="useLoc" type="button">Use my location</button>
          </div>

          <div style="margin-left:auto">
            <button id="sendBtn" type="submit">Send Report</button>
          </div>
        </div>
      </form>

      <div id="result" class="out" style="display:none;"></div>
      <div id="mlpanel" style="display:none;"></div>
    </div>
  </div>

<script>
async function geoLocateAndFill() {
  const out = document.getElementById('result');
  out.style.display = 'block'; out.textContent = 'Attempting to get your location...';
  if (!navigator.geolocation) { out.textContent = 'Geolocation not supported.'; return; }
  navigator.geolocation.getCurrentPosition(function(pos){
    document.getElementById('lat').value = pos.coords.latitude.toFixed(6);
    document.getElementById('lon').value = pos.coords.longitude.toFixed(6);
    out.textContent = 'Location filled ✔ — you can now submit the report.';
  }, function(err){
    out.textContent = 'Could not get location: ' + (err.message || 'permission denied');
  }, { enableHighAccuracy:true, timeout:10000 });
}

function createBadge(text, type){
  const s = document.createElement('span');
  s.className = 'badge ' + (type === 'danger' ? 'badge-danger' : (type === 'warn' ? 'badge-warn' : (type === 'muted' ? 'badge-muted' : 'badge-accent')));
  s.textContent = text;
  return s;
}

function prettyPrintResponse(j){
  if (!j) return 'No response';
  let out = [];
  if (j.status) out.push('Status: ' + j.status);
  if (j.report_id) out.push('Report ID: ' + j.report_id);
  if (typeof j.is_emergency !== 'undefined') out.push('Is emergency: ' + j.is_emergency);
  if (typeof j.urgency !== 'undefined') out.push('Urgency score: ' + j.urgency);
  if (j.location_text) out.push('Resolved location: ' + j.location_text);
  if (j.resolved_lat && j.resolved_lon) out.push('Map: https://www.google.com/maps/search/?api=1&query=' + j.resolved_lat + ',' + j.resolved_lon);
  if (j.assigned_helpers && j.assigned_helpers.length) {
    out.push('');
    out.push('Assigned helpers:');
    j.assigned_helpers.forEach(h => out.push(' • ' + (h.name || 'helper') + ' (id:' + (h.helper_id||'?') + ', ' + (h.dist_km||'?') + ' km, ' + (h.email||'N/A') + ')'));
  } else {
    out.push('Assigned helpers: none');
  }
  return out.join('\\n');
}

function renderMLSection(container, ml) {
  container.innerHTML = '';
  const box = document.createElement('div');
  box.className = 'ml-box';

  if (!ml || Object.keys(ml).length === 0) {
    box.appendChild(createBadge('None predicted', 'muted'));
    container.appendChild(box);
    return;
  }

  // collect predicted
  const predicted = [];
  for (const k of Object.keys(ml)) {
    if (k === 'ml_confidence') continue;
    const v = ml[k];
    if (v === 1 || v === true || v === '1' || v === 'true') predicted.push(k);
  }

  const title = document.createElement('div');
  title.style.marginBottom = '8px';
  title.textContent = 'AI predicted categories:';
  box.appendChild(title);

  if (predicted.length === 0) {
    box.appendChild(createBadge('None predicted', 'muted'));
  } else {
    predicted.forEach(cat => {
      // color important categories
      let t = 'accent';
      if (['medical_help','search_and_rescue','hospitals','death'].includes(cat)) t = 'danger';
      else if (['request','shelter','water','food'].includes(cat)) t = 'warn';
      box.appendChild(createBadge(cat, t));
    });
  }

  // optional confidence display if the backend included it
  if (ml.ml_confidence !== undefined) {
    const conf = document.createElement('div');
    conf.className = 'small-muted';
    conf.style.marginTop = '8px';
    conf.textContent = 'Model confidence: ' + ml.ml_confidence;
    box.appendChild(conf);
  }

  container.appendChild(box);
}

document.getElementById('useLoc').addEventListener('click', geoLocateAndFill);

document.getElementById('repForm').addEventListener('submit', async function(e){
  e.preventDefault();
  const sendBtn = document.getElementById('sendBtn');
  sendBtn.disabled = true; sendBtn.textContent = 'Sending...';

  const message = document.getElementById('message').value.trim();
  const latVal = document.getElementById('lat').value.trim();
  const lonVal = document.getElementById('lon').value.trim();
  const payload = { message: message };
  if (latVal) payload.lat = Number(latVal);
  if (lonVal) payload.lon = Number(lonVal);

  const out = document.getElementById('result');
  out.style.display = 'block'; out.textContent = 'Sending report...';
  const mlpanel = document.getElementById('mlpanel');
  mlpanel.style.display = 'none'; mlpanel.innerHTML = '';

  try {
    const resp = await fetch('/reports', {
      method:'POST',
      headers:{ 'Content-Type':'application/json' },
      body: JSON.stringify(payload)
    });
    const j = await resp.json().catch(()=>null);
    if (!j) {
      out.textContent = 'No JSON response from server (status ' + resp.status + ')';
    } else {
      out.textContent = prettyPrintResponse(j);
      if (j.resolved_lat && j.resolved_lon) {
        const mapA = document.createElement('div');
        mapA.innerHTML = '<br><a class="map-link" target="_blank" href="https://www.google.com/maps/search/?api=1&query='
                         + encodeURIComponent(j.resolved_lat + ',' + j.resolved_lon)
                         + '">Open in Google Maps</a>';
        out.appendChild(mapA);
      }

      // ML panel
      mlpanel.style.display = 'block';
      renderMLSection(mlpanel, j.ml_info || j.ml_categories || {});
      out.parentNode.appendChild(mlpanel);
    }
  } catch (err) {
    out.textContent = 'Error sending request: ' + (err && err.message ? err.message : String(err));
  } finally {
    sendBtn.disabled = false; sendBtn.textContent = 'Send Report';
  }
});
</script>
</body>
</html>
